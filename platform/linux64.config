# Fragment applied on top of tinyconfig (see scripts/build-linux64.sh).
# Target: RV64IMA + Zicsr + Zifencei only; no C, F/D, V; Sv39; S/U mode.
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_RISCV_ISA_C=n
CONFIG_FPU=n
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_ZBA=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZBC=n
CONFIG_RISCV_ISA_ZAWRS=n
CONFIG_RISCV_ISA_ZACAS=n
CONFIG_RISCV_ISA_SVNAPOT=n
CONFIG_RISCV_ISA_SVPBMT=n
CONFIG_RISCV_ALTERNATIVE=n
CONFIG_RISCV_SBI=y
CONFIG_ERRATA_SIFIVE=n
CONFIG_ERRATA_THEAD=n
CONFIG_SOC_MICROCHIP_POLARFIRE=n
CONFIG_ARCH_SIFIVE=n
CONFIG_ARCH_SOPHGO=n
CONFIG_ARCH_STARFIVE=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_THEAD=n
CONFIG_ARCH_VIRT=n
CONFIG_SOC_VIRT=n
CONFIG_EFI=n
CONFIG_RELOCATABLE=n
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_HZ_100=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y
CONFIG_OF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=n
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_MULTIUSER=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_PROC_SYSCTL=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_MODULES=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT2_FS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_CMDLINE="earlycon console=ttyS0"
CONFIG_CMDLINE_FALLBACK=y
